{
  "name": "english-learning-platform",
  "version": "0.1.0",
  "description": "AI-powered English Learning & Mastery Platform with ChatGPT integration",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/frontend",
    "packages/backend"
  ],
  "scripts": {
    "app:start": "node scripts/control-server.js",
    "app:install": "node scripts/install-mac-service.js",
    "app:uninstall": "node scripts/install-mac-service.js --uninstall",
    "app:start:legacy": "node scripts/start-app.js",
    "app:start:quick": "node scripts/start-app.js --quick",
    "app:doctor": "node scripts/start-app.js --doctor",
    "setup": "yarn install && yarn run setup:backend",
    "setup:backend": "yarn run db:setup",
    "db:setup": "yarn run db:migrate && yarn run db:seed",
    "db:migrate": "knex --knexfile knexfile.js migrate:latest",
    "db:seed": "knex --knexfile knexfile.js seed:run",
    "db:status": "knex --knexfile knexfile.js migrate:status",
    "dev": "node scripts/dev.js",
    "dev:backend": "yarn workspace english-learning-backend run dev",
    "dev:frontend": "yarn workspace english-learning-frontend run dev",
    "build": "yarn workspace english-learning-backend run build && yarn workspace english-learning-frontend run build",
    "test": "yarn workspace english-learning-backend run test",
    "test:control": "node --test scripts/control-server.test.js",
    "content-packs:validate": "ts-node --transpile-only --project packages/backend/tsconfig.json packages/backend/src/scripts/validate-content-packs.ts",
    "content-packs:sync": "ts-node --transpile-only --project packages/backend/tsconfig.json packages/backend/src/scripts/sync-content-packs.ts",
    "smoke:content-packs": "ts-node --transpile-only --project packages/backend/tsconfig.json packages/backend/src/scripts/smoke-content-pack-postgres.ts",
    "lint": "yarn workspace english-learning-backend run lint && yarn workspace english-learning-frontend run lint",
    "type-check": "yarn workspace english-learning-backend run type-check && yarn workspace english-learning-frontend run type-check",
    "validate": "yarn run lint && yarn run type-check && yarn run test --runInBand && yarn run test:control && yarn run build",
    "start": "node scripts/dev.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "eslint": "^8.54.0",
    "playwright": "^1.61.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "knex": "^3.2.10"
  }
}
