{
  "name": "english-learning-backend",
  "version": "0.1.0",
  "description": "Express backend for English Learning Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "HOST=127.0.0.1 PORT=5001 ts-node-dev --respawn --transpile-only src/index.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "worker:build": "node dist/worker.js",
    "build": "tsc",
    "start": "HOST=127.0.0.1 PORT=5001 node dist/index.js",
    "setup:db": "yarn run db:migrate && yarn run db:seed",
    "db:migrate": "knex --knexfile ../../knexfile.js migrate:latest",
    "db:seed": "knex --knexfile ../../knexfile.js seed:run",
    "db:rollback": "knex --knexfile ../../knexfile.js migrate:rollback",
    "db:reset": "yarn run db:rollback && yarn run db:migrate && yarn run db:seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1",
    "nodemailer": "^6.9.7",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "knex": "^3.2.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "express-session": "^1.17.3",
    "bullmq": "^5.12.12",
    "ioredis": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "srt-parser-2": "^1.2.3",
    "epub2": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.11",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-github2": "^1.0.5",
    "@types/express-session": "^1.17.10",
    "@types/nodemailer": "^6.4.14",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
