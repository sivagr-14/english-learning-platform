# ============================================================
# BACKEND CONFIGURATION
# ============================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=english_learning
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_learning

# Redis Cache
REDIS_URL=redis://localhost:6379

# Server
PORT=5001
NODE_ENV=development

# JWT Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000

# ============================================================
# AUTHENTICATION
# ============================================================

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google

# GitHub OAuth (Get from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/oauth/github

# Email (for magic links and password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@englishlearning.com

# ============================================================
# OPTIONAL EXTERNAL SERVICES
# ============================================================

# Google Translate API (Get from Google Cloud Console)
GOOGLE_TRANSLATE_API_KEY=

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info
LOG_FILE=logs/combined.log
LOG_ERROR_FILE=logs/error.log

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

# Next.js App
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_APP_NAME=English Mastery
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ============================================================
# DEPLOYMENT
# ============================================================

ENVIRONMENT=development

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Spaced-repetition new-card pacing
# Caps how many not-yet-studied words enter the due queue per calendar day,
# regardless of how many words a single import contains.
NEW_CARDS_PER_DAY=20

# ============================================================
# DATABASE BACKUP & MONITORING
# ============================================================

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# Sentry error tracking (optional)
SENTRY_DSN=

# ============================================================
# FEATURE FLAGS
# ============================================================

FEATURE_CHATGPT_CONTENT_PACKS=true
FEATURE_ANKI_SYNC=false
FEATURE_GRAMMAR_TOPICS=false
FEATURE_COMMUNICATION_SKILLS=false
# Comma-separated browser origins allowed to call the local backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
