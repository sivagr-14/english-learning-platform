{
  "schemaVersion": 1,
  "featureId": "universal-chatgpt-source-input",
  "title": "Accept pasted text and every supported document format in ChatGPT imports",
  "implementationPaths": [
    "packages/backend/src/scripts/build-content-inventory.ts",
    "packages/frontend/app/generate/page.tsx"
  ],
  "validationPaths": [
    "packages/backend/src/scripts/build-content-inventory.test.ts"
  ],
  "chatgptInstructionImpact": {
    "status": "required",
    "instructionPaths": [
      "docs/CHATGPT_CONTENT_PACK_WORKFLOW.md"
    ],
    "requiredMarkers": [
      {
        "path": "docs/CHATGPT_CONTENT_PACK_WORKFLOW.md",
        "contains": [
          "Pasted text is a first-class source",
          "content-packs:inventory - text <stable-source-name>",
          "TXT, MD, PDF, DOCX, EPUB"
        ]
      }
    ]
  }
}
